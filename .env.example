# Copy to .env. Everything works with no API key (agents fall back to rules).
ANTHROPIC_API_KEY=
CIVICFLOW_LLM_MODEL=claude-sonnet-5-5

# live | record | replay   (replay serves backend/agent_cache; a cache miss falls back to rules)
AGENT_MODE=live

# 60 = 1 real minute is 1 SLA hour
TIME_SCALE=60
# Demo mode freezes the simulated clock origin here so the replay cache stays deterministic
DEMO_MODE=true
DEMO_EPOCH=2026-11-05T09:00:00+05:30

SECRET_KEY=change-me-in-real-life
OEM_SIM_API_KEY=oem-sim-demo-key

# Host ports (change if another project already uses them). Containers always talk to db:5432 / api:8000.
DB_PORT=5433
API_PORT=8000
WEB_PORT=5173
